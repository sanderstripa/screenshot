101 ICON "../assets/Screenshot.ico"

1 VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Screenshot\0"
            VALUE "FileDescription", "Screenshot - native screen capture\0"
            VALUE "FileVersion", "2.0.0.0\0"
            VALUE "InternalName", "Screenshot\0"
            VALUE "OriginalFilename", "Screenshot.exe\0"
            VALUE "ProductName", "Screenshot\0"
            VALUE "ProductVersion", "2.0.0\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Sander Stripa\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
